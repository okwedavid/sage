# SAGE Backend - Production Configuration
PORT=4000
NODE_ENV=production

# Groq AI Engine (REQUIRED - Get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
SAGE_DEFAULT_MODEL=llama-3.3-70b-versatile
SAGE_VISION_MODEL=llama-3.2-11b-vision-preview

# Supabase (Optional - for persistence)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (Update after deploying frontend)
FRONTEND_URL=https://your-frontend.vercel.app
