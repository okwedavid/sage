# ── SAGE Backend — Development environment ──────────────────────────────
# Copy to .env and fill in real values. Committed as documentation only.

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Groq AI
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAGE_DEFAULT_MODEL=llama-3.3-70b-versatile
SAGE_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=30000

# Supabase (optional in dev; required in production for persistence)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Provider credential encryption (Phase 2/3)
# Encrypts user-supplied third-party AI API keys at rest (AES-256-GCM).
# REQUIRED in production before users can connect their own providers.
# Generate with: openssl rand -hex 32
SAGE_CREDENTIAL_ENCRYPTION_KEY=

# Email (password reset delivery)
# Optional in dev — without RESEND_API_KEY the reset link is returned as
# `devResetUrl` in non-production only, so local flows work with no SMTP.
# REQUIRED in production for password reset emails. Get a key at
# https://resend.com (free tier included).
RESEND_API_KEY=
EMAIL_FROM=SAGE <no-reply@sage.ai>
PASSWORD_RESET_TTL_MS=3600000

# Password reset rate limits (requests per 15 min)
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_MAX=10

# Stripe (test mode) — optional
# Checkout, billing portal, and webhooks all activate the moment these four
# are set; until then the billing routes return the `payment_provider_not_configured`
# contract and webhooks answer 501. Get keys at https://dashboard.stripe.com/test/apikeys
# and price ids from Products → API ID (create recurring 'pro'/'team' prices).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Input limits
MAX_MESSAGE_LENGTH=50000
MAX_ATTACHMENT_BYTES=8388608

# Logging (debug | info | warn | error)
LOG_LEVEL=debug
