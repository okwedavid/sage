# ── SAGE Backend — Production environment ───────────────────────────────
# Reference template for Railway/Vercel. Never commit real secrets.
# Prefer injecting these as platform environment variables.

# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Groq AI — REQUIRED
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAGE_DEFAULT_MODEL=llama-3.3-70b-versatile
SAGE_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=30000

# Supabase — REQUIRED (both or neither; backend falls back to in-memory)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key

# Provider credential encryption — REQUIRED for the BYO-provider feature
# (Phase 2/3). Without it, users cannot connect their own AI API keys in
# production. Generate: openssl rand -hex 32
SAGE_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_RANDOM_STRING

# JWT — REQUIRED: a strong random secret (>= 24 chars). The default dev
# secret is refused at boot in production (assertProductionSafe).
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Input limits
MAX_MESSAGE_LENGTH=50000
MAX_ATTACHMENT_BYTES=8388608

# Logging — production emits JSON lines for log aggregators
LOG_LEVEL=info
